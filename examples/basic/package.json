{
  "name": "@payload-calendar/example-basic",
  "version": "0.0.1",
  "private": true,
  "description": "Basic example demonstrating payload-calendar-plugin",
  "type": "module",
  "scripts": {
    "dev": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx src/server.ts",
    "build": "payload build",
    "start": "cross-env PAYLOAD_CONFIG_PATH=dist/payload.config.js node dist/server.js",
    "generate:types": "payload generate:types",
    "generate:schema": "payload generate:db-schema"
  },
  "dependencies": {
    "@payload-calendar/core": "workspace:*",
    "@payload-calendar/orthodox": "workspace:*",
    "@payloadcms/db-sqlite": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "cross-env": "^7.0.3",
    "express": "^4.18.2",
    "payload": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
