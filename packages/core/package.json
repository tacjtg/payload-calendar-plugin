{
  "name": "@payload-calendar/core",
  "version": "0.0.1",
  "description": "Core calendar plugin for Payload CMS - events, sources, recurrence, iCal",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./collections": {
      "import": "./dist/collections/index.mjs",
      "require": "./dist/collections/index.js",
      "types": "./dist/collections/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "payload": "^3.0.0"
  },
  "dependencies": {
    "rrule": "^2.8.1",
    "ical.js": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "payload": "^3.0.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "plugin",
    "calendar",
    "events",
    "scheduling",
    "ical",
    "recurrence"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tacjtg/payload-calendar-plugin",
    "directory": "packages/core"
  }
}
